# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Node / frontend build artifacts (frontend/.gitignore repeats these; kept
# here too so nothing under frontend/ can be committed from the repo root)
node_modules/
*.tsbuildinfo

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Environment variables / secrets
.env
*.env
.env.*
!.env.example

# Deployment: Vercel CLI project link, database dumps (contain customer
# data and the Gmail refresh token). deploy/*.env is covered by *.env above.
.vercel/
*.dump
*.sql.gz
deploy/*.sql.bak

# Jupyter
.ipynb_checkpoints/

# Editors / IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
