# Copy to .env and fill in real values. Never commit .env.
# For deployment, deploy/render-api.env and deploy/render-scheduler.env hold
# ready-to-paste copies of these per Render service (see DEPLOYMENT.md).

# Postgres connection used by every script (customers/tracking tables,
# LangGraph checkpoints). Format: postgresql://user:password@host:port/dbname
# On Supabase use the *session* pooler (port 5432), not the transaction
# pooler (6543):
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# OpenAI -- email drafting/rewriting, reply classification, and the
# Composio Calendly Tool Router agent (agents/runtime/composio.py,
# agents/lead_find_agent.py, agents/send_booking_agent.py).
OPENAI_API_KEY=

# OpenWeather -- powers agents/mcp_servers/weather_server.py (the custom
# stdio MCP server agents/lead_find_agent.py checks storm conditions
# through).
OPENWEATHER_API_KEY=

# Klavis hosted MCP servers -- Gmail send/read and Slack post/list-channels.
KLAVIS_GMAIL_MCP_URL=
KLAVIS_SLACK_MCP_URL=
KLAVIS_MCP_TOKEN=

# Composio -- Calendly Tool Router session (scheduling links + booking
# lookups). COMPOSIO_USER_ID identifies which connected Calendly account to
# use.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# Scheduler (backend/scheduler.py) -- IANA zone the 08:00 / 08:30 daily jobs
# run in. Unset means the host's local zone (UTC on most cloud hosts).
SCHEDULER_TIMEZONE=America/Chicago

# Optional: LangSmith tracing of every agent run.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Dashboard API (backend/) -- all optional.
# DASHBOARD_PORT=8000            # falls back to $PORT, then 8000
# DASHBOARD_POOL_MAX_SIZE=4      # keep small on Supabase's session pooler
# DASHBOARD_CORS_ORIGINS=https://your-app.vercel.app
