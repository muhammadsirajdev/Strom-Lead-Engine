# Copy to .env.local to override. Both are optional.

# Where the FastAPI backend lives. Leave unset to use the Vite dev proxy
# (relative /api paths -> http://127.0.0.1:8000), which is the default.
# Set this only when serving the built frontend from a different origin.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Target the Vite dev-server proxy forwards /api to.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Polling interval for the live queries, in milliseconds (default 12000).
# VITE_POLL_INTERVAL_MS=12000
